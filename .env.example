# ==============================================================================
# converse-guard — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and supply your environment-specific values.
# NEVER commit or expose production API keys or credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiteLLM Gateway Authentication & Runtime
# ------------------------------------------------------------------------------
# Secret master key protecting the gateway's /bedrock and administrative routes.
# Client requests must supply: Authorization: Bearer <LITELLM_MASTER_KEY>
LITELLM_MASTER_KEY=sk-replace-with-your-gateway-master-key

# Path to the LiteLLM YAML routing configuration file inside the container.
CONFIG_FILE_PATH=/opt/converse-guard/config.yaml

# Module search path inside the container to load custom adapter modules.
PYTHONPATH=/opt/converse-guard:/app

# Use local cost map to prevent outbound GitHub requests on container startup.
LITELLM_LOCAL_MODEL_COST_MAP=True

# ------------------------------------------------------------------------------
# 2. Amazon Bedrock Configuration
# ------------------------------------------------------------------------------
# Target Bedrock foundation model or cross-region system-defined inference profile.
# Format: bedrock/<MODEL_OR_INFERENCE_PROFILE_ID>
# Illustration: bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
# Note: Account model access and matching Bedrock IAM permissions are required.
BEDROCK_MODEL_ID=bedrock/your-bedrock-model-or-inference-profile-id

# AWS region to which Bedrock API requests are sent (e.g., us-east-1).
# Note: Cross-region system-defined inference profiles can route and execute in other regions.
AWS_REGION_NAME=us-east-1

# Optional Static AWS Credentials:
# NOTE: Host AWS SSO sessions (e.g., `aws sso login`) reside in ~/.aws and are NOT
# automatically accessible inside container environments unless AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, and AWS_SESSION_TOKEN are explicitly exported as temporary
# credentials. Leave these commented out if running on EC2/ECS where the container
# reaches instance metadata (IMDSv2) to assume an attached IAM role.
# Setting these to empty strings will cause credential errors; omit or comment out if unused.
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-aws-session-token

# ------------------------------------------------------------------------------
# 3. Zscaler AI Guard Configuration
# ------------------------------------------------------------------------------
# Full detection endpoint URL for your Zscaler AI Guard tenant.
# Construction format: https://api.<ZSCALER_CLOUD>.zseclipse.net/v1/detection/execute-policy
# Examples:
#   https://api.us1.zseclipse.net/v1/detection/execute-policy
#   https://api.eu1.zseclipse.net/v1/detection/execute-policy
AIGUARD_URL=https://api.your-zscaler-cloud.zseclipse.net/v1/detection/execute-policy

# AI Guard API Bearer token generated from your Zscaler AI Guard portal.
AIGUARD_API_KEY=your-zscaler-ai-guard-api-token

# Integer detection policy ID defined in the Zscaler OneID / AI Guard portal.
# MUST be replaced with a valid integer (e.g., 1256) before startup; non-integer values fail.
AIGUARD_POLICY_ID=your-integer-policy-id

# Inspection mode:
#   'batch' - Progressive streaming; releases chunks as batch thresholds are met.
#   'full'  - Complete buffering; holds all chunks until full text is approved.
AIGUARD_STREAM_MODE=batch

# Trigger an OUT scan after this many new characters since the previous scan.
# Each scan inspects the cumulative generated text; final text is also scanned.
AIGUARD_BATCH_CHARS=256

# ------------------------------------------------------------------------------
# 4. Optional Adapter Tuning Settings (Defaults shown; uncomment to override)
# ------------------------------------------------------------------------------
# HTTP client timeout in seconds for AI Guard REST requests.
# AIGUARD_TIMEOUT_SECONDS=10.0

# Maximum UTF-8 content byte limit allowed for a single inspection scan.
# AIGUARD_MAX_CONTENT_BYTES=65536

# Maximum Bedrock EventStream binary frame size in bytes.
# AIGUARD_MAX_FRAME_BYTES=1048576

# Maximum cumulative unreleased buffer bytes allowed before failing closed.
# AIGUARD_MAX_PENDING_BYTES=2097152
